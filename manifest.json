{
  "manifest_version": 3,
  "name": "Ayah Tab",
  "description": "Show a Quran ayah with tafsir and audio on every new tab.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.alquran.cloud/*"
  ]
}
